# Contract smoke test without credentials or Java bridge.
import "@flow/src/App.ow"
import "../src/gateway/api/GatewayApi.ow"
import "../src/rest/api/RestApi.ow"

module OWCord.MockGateway: DISCORD_GATEWAY
  fn name() -> string:
    return: "gateway"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn connected() -> int:
    return: 1
  fn poll(timeout_ms int) -> string:
    return: "{\"type\":\"NONE\",\"data\":{}}"

module OWCord.MockRest: DISCORD_REST
  fn name() -> string:
    return: "rest"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn register_dev_command(name string, description string) -> int:
    return: 201
  fn reply(interaction_id string, interaction_token string, content string) -> int:
    return: 204
  fn send_message(channel_id string, content string) -> int:
    return: 200
  fn reply_ephemeral(interaction_id string, interaction_token string, content string) -> int:
    return: 204
  fn defer(interaction_id string, interaction_token string, private int) -> int:
    return: 204
  fn followup(interaction_token string, content string) -> int:
    return: 200
  fn followup_ephemeral(interaction_token string, content string) -> int:
    return: 200
  fn register_dev_command_permissions(name string, description string, permissions string) -> int:
    return: 201
  fn register_dev_command_options(name string, description string, options_json string, permissions string) -> int:
    return: 201
  fn autocomplete(interaction_id string, interaction_token string, choices_json string) -> int:
    return: 204
  fn send_rich(channel_id string, message_json string) -> int:
    return: 201
  fn reply_rich(interaction_id string, interaction_token string, message_json string) -> int:
    return: 204
  fn reply_rich_private(interaction_id string, interaction_token string, message_json string) -> int:
    return: 204
  fn update_component(interaction_id string, interaction_token string, message_json string) -> int:
    return: 204
  fn open_modal(interaction_id string, interaction_token string, modal_json string) -> int:
    return: 204
  fn message_create(channel_id string, content string) -> string:
    return: "12345"
  fn message_get(channel_id string, message_id string) -> string:
    return: "{\"id\":\"12345\",\"channel_id\":\"55\",\"content\":\"hello\",\"author_id\":\"66\",\"timestamp\":\"\",\"edited_timestamp\":\"\",\"pinned\":false}"
  fn message_list(channel_id string, cursor string, direction string, limit int) -> string:
    return: "[]"
  fn message_edit(channel_id string, message_id string, content string) -> string:
    return: "{\"id\":\"12345\",\"channel_id\":\"55\",\"content\":\"edited\",\"author_id\":\"66\",\"timestamp\":\"\",\"edited_timestamp\":\"\",\"pinned\":false}"
  fn message_delete(channel_id string, message_id string) -> int:
    return: 204
  fn reaction_add(channel_id string, message_id string, emoji string) -> int:
    return: 204
  fn reaction_remove(channel_id string, message_id string, emoji string) -> int:
    return: 204
  fn reaction_users(channel_id string, message_id string, emoji string, after string, limit int) -> string:
    return: "[]"

  fn guild_get(guild_id string) -> string:
    return: "{\"id\":\"111\",\"name\":\"OWCord test guild\",\"owner_id\":\"222\",\"description\":\"\",\"member_count\":0}"
  fn guild_channels(guild_id string) -> string:
    return: "[{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"general\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}]"
  fn channel_get(channel_id string) -> string:
    return: "{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"general\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"
  fn guild_roles(guild_id string) -> string:
    return: "[{\"id\":\"444\",\"name\":\"Tester\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}]"
  fn guild_member(guild_id string, user_id string) -> string:
    return: "{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false}"
  fn guild_members(guild_id string, after_id string, limit int) -> string:
    return: "[{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false}]"
  fn guild_channel_create(guild_id string, name string, topic string, reason string) -> string:
    return: "{\"id\":\"555\",\"guild_id\":\"111\",\"name\":\"new\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"
  fn channel_edit(channel_id string, name string, topic string, reason string) -> string:
    return: "{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"renamed\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"
  fn channel_delete(channel_id string, reason string) -> int:
    return: 204
  fn guild_role_create(guild_id string, name string, reason string) -> string:
    return: "{\"id\":\"666\",\"name\":\"Safe\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}"
  fn guild_role_edit(guild_id string, role_id string, name string, reason string) -> string:
    return: "{\"id\":\"444\",\"name\":\"Updated\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}"
  fn guild_role_delete(guild_id string, role_id string, reason string) -> int:
    return: 204
  fn guild_member_role_add(guild_id string, user_id string, role_id string, reason string) -> int:
    return: 204
  fn guild_member_role_remove(guild_id string, user_id string, role_id string, reason string) -> int:
    return: 204

  fn permission_effective(guild_json string, member_json string, channel_json string, roles_json string) -> string:
    return: "1024"
  fn permission_can_moderate(guild_json string, actor_json string, target_json string, roles_json string, action string) -> int:
    return: 204
  fn permission_role_manageable(guild_json string, actor_json string, role_id string, roles_json string) -> int:
    return: 204
  fn moderation_kick(guild_id string, user_id string, reason string) -> int:
    return: 204
  fn moderation_ban(guild_id string, user_id string, delete_message_seconds int, reason string) -> int:
    return: 204
  fn moderation_unban(guild_id string, user_id string, reason string) -> int:
    return: 204
  fn moderation_timeout(guild_id string, user_id string, until_iso string, reason string) -> string:
    return: "{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false,\"communication_disabled_until\":\"\"}"
  fn moderation_clear_timeout(guild_id string, user_id string, reason string) -> string:
    return: "{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false,\"communication_disabled_until\":\"\"}"

main:
  set app: new App()
  call: app.use_native_as(OWCord.MockGateway, "DISCORD_GATEWAY")
  call: app.use_native_as(OWCord.MockRest, "DISCORD_REST")
  call: assert(app.boot() == 1, "flOW boot")
  set gateway DISCORD_GATEWAY: app.service("gateway")
  set rest DISCORD_REST: app.service("rest")
  call: assert(gateway.connected() == 1, "gateway mock")
  set event: json_parse(gateway.poll(0))
  call: assert(event.type == "NONE", "event format")
  call: assert(rest.register_dev_command("ping", "test") == 201, "commands")
  call: assert(rest.reply("1", "token", "pong") == 204, "reply")
  call: assert(rest.send_message("2", "hello") == 200, "messages")
  call: assert(app.stop() == 1, "clean shutdown")
  print: "PASS: typed OWCord contracts and flOW lifecycle"
