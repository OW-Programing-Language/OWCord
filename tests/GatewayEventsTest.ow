import "../src/events/EventParser.ow"

@Test
fn normalizesMessageMutationsWithPartialFields():
  set parser: new EventParser()
  set edited: parser.decode("{\"type\":\"MESSAGE_UPDATE\",\"data\":{\"id\":\"10\",\"channel_id\":\"20\"}}")
  call: assert(edited.kind == "message")
  call: assert(edited.action == "update")
  call: assert(edited.id == "10")
  call: assert(edited.channel_id == "20")
  call: assert(edited.content == "")
  set removed: parser.decode("{\"type\":\"MESSAGE_DELETE\",\"data\":{\"id\":\"10\",\"guild_id\":\"30\"}}")
  call: assert(removed.kind == "message")
  call: assert(removed.action == "delete")
  call: assert(removed.guild_id == "30")

@Test
fn parsesMemberAndChannelLifecycleEvents():
  set parser: new EventParser()
  set joined: parser.decode("{\"type\":\"GUILD_MEMBER_ADD\",\"data\":{\"guild_id\":\"30\",\"user\":{\"id\":\"55\"}}}")
  call: assert(joined.kind == "member")
  call: assert(joined.action == "add")
  call: assert(joined.user_id == "55")
  set changed: parser.decode("{\"type\":\"GUILD_MEMBER_UPDATE\",\"data\":{\"guild_id\":\"30\",\"user\":{\"id\":\"55\"}}}")
  call: assert(changed.kind == "member")
  call: assert(changed.action == "update")
  set left: parser.decode("{\"type\":\"GUILD_MEMBER_REMOVE\",\"data\":{\"guild_id\":\"30\",\"user\":{\"id\":\"55\"}}}")
  call: assert(left.kind == "member")
  call: assert(left.action == "remove")
  set channel: parser.decode("{\"type\":\"CHANNEL_DELETE\",\"data\":{\"id\":\"40\",\"guild_id\":\"30\"}}")
  call: assert(channel.kind == "channel")
  call: assert(channel.action == "delete")
  call: assert(channel.id == "40")

@Test
fn readsInteractionPermissionStringsWithoutFloatingPointConversion():
  set parser: new EventParser()
  set request: parser.decode("{\"type\":\"INTERACTION_CREATE\",\"data\":{\"type\":2,\"id\":\"2\",\"guild_id\":\"30\",\"app_permissions\":\"1152921504606846976\",\"member\":{\"permissions\":\"8192\",\"user\":{\"id\":\"55\"}},\"data\":{\"name\":\"mod\"}}}")
  call: assert(request.kind == "command")
  call: assert(request.member_permissions == "8192")
  call: assert(request.app_permissions == "1152921504606846976")
  call: assert(request.user_id == "55")
  set dm: parser.decode("{\"type\":\"INTERACTION_CREATE\",\"data\":{\"type\":2,\"id\":\"2\",\"data\":{\"name\":\"mod\"}}}")
  call: assert(dm.member_permissions == "")
  set resumed: parser.decode("{\"type\":\"RESUMED\",\"data\":{}}")
  call: assert(resumed.kind == "ready")
  call: assert(resumed.action == "resumed")

@Test
fn preservesUnknownEventsRatherThanFabricatingLifecycle():
  set parser: new EventParser()
  set unknown: parser.decode("{\"type\":\"SOME_NEW_DISCORD_EVENT\",\"data\":{\"id\":\"10\"}}")
  call: assert(unknown.kind == "other")
  call: assert(unknown.name == "SOME_NEW_DISCORD_EVENT")


@Test
fn preservesPartialMessageUpdatesWithoutFabricatingContent():
  set parser: new EventParser()
  set sparse: parser.decode("{\"type\":\"MESSAGE_UPDATE\",\"data\":{\"id\":\"101\",\"channel_id\":\"202\"}}")
  call: assert(sparse.kind == "message")
  call: assert(sparse.partial == true)
  call: assert(sparse.content_present == false)
  call: assert(sparse.content == "")
  set cleared: parser.decode("{\"type\":\"MESSAGE_UPDATE\",\"data\":{\"id\":\"101\",\"channel_id\":\"202\",\"content\":\"\"}}")
  call: assert(cleared.content_present == true)
  call: assert(cleared.content == "")
  set created: parser.decode("{\"type\":\"MESSAGE_CREATE\",\"data\":{\"id\":\"101\",\"content\":\"hi\"}}")
  call: assert(created.content_present == true)
  call: assert(created.partial == false)

@Test
fn typedRoleEventsRetainPartialPayloadAndIds():
  set parser: new EventParser()
  set created: parser.decode("{\"type\":\"GUILD_ROLE_CREATE\",\"data\":{\"guild_id\":\"30\",\"role\":{\"id\":\"44\",\"name\":\"Blue\"}}}")
  call: assert(created.kind == "role")
  call: assert(created.action == "create")
  call: assert(created.role_id == "44")
  call: assert(created.role.name == "Blue")
  set changed: parser.decode("{\"type\":\"GUILD_ROLE_UPDATE\",\"data\":{\"guild_id\":\"30\",\"role\":{\"id\":\"44\"}}}")
  call: assert(changed.action == "update")
  call: assert(changed.partial == true)
  call: assert(changed.role_id == "44")
  set deleted: parser.decode("{\"type\":\"GUILD_ROLE_DELETE\",\"data\":{\"guild_id\":\"30\",\"role_id\":\"44\"}}")
  call: assert(deleted.action == "delete")
  call: assert(deleted.role_id == "44")

@Test
fn typedThreadsAndReactionsKeepDiscordSnowflakesAsStrings():
  set parser: new EventParser()
  set thread: parser.decode("{\"type\":\"THREAD_CREATE\",\"data\":{\"id\":\"9001\",\"guild_id\":\"30\",\"parent_id\":\"44\"}}")
  call: assert(thread.kind == "thread")
  call: assert(thread.thread_id == "9001")
  call: assert(thread.channel_id == "44")
  set updated: parser.decode("{\"type\":\"THREAD_UPDATE\",\"data\":{\"id\":\"9001\",\"guild_id\":\"30\"}}")
  call: assert(updated.partial == true)
  set reaction: parser.decode("{\"type\":\"MESSAGE_REACTION_ADD\",\"data\":{\"guild_id\":\"30\",\"channel_id\":\"44\",\"message_id\":\"9001\",\"user_id\":\"222\",\"emoji\":{\"id\":null,\"name\":\"👍\"}}}")
  call: assert(reaction.kind == "reaction")
  call: assert(reaction.action == "add")
  call: assert(reaction.message_id == "9001")
  call: assert(reaction.user_id == "222")
  call: assert(reaction.emoji.name == "👍")
  set removed: parser.decode("{\"type\":\"MESSAGE_REACTION_REMOVE_ALL\",\"data\":{\"message_id\":\"9001\",\"channel_id\":\"44\"}}")
  call: assert(removed.action == "remove_all")
  set bulk: parser.decode("{\"type\":\"MESSAGE_DELETE_BULK\",\"data\":{\"guild_id\":\"30\",\"channel_id\":\"44\",\"ids\":[\"9001\"]}}")
  call: assert(bulk.kind == "message_bulk")
  call: assert(bulk.action == "delete")
  call: assert(bulk.payload.ids[0] == "9001")

@Test
fn propagatesSourceShardIdAcrossTypedEvents():
  set parser: new EventParser()
  set a: parser.decode("{\"type\":\"MESSAGE_CREATE\",\"shard_id\":3,\"data\":{\"id\":\"444\",\"content\":\"hello\"}}")
  call: assert(a.kind == "message")
  call: assert(a.shard_id == 3)
  set b: parser.decode("{\"type\":\"RESUMED\",\"shard_id\":2,\"data\":{}}")
  call: assert(b.kind == "ready")
  call: assert(b.action == "resumed")
  call: assert(b.shard_id == 2)
  set c: parser.decode("{\"type\":\"READY\",\"data\":{}}")
  call: assert(c.shard_id == 0)
