# Run with: ow test tests/ClientTest.ow
# Exercises the public OWCordClient facade without any network or bot token.
import "../src/client/OWCordClient.ow"

class FakeGateway:
  field values
  field index

  fn new():
    set this.values: [
      "{\"type\":\"READY\",\"data\":{}}",
      "{\"type\":\"INTERACTION_CREATE\",\"data\":{\"id\":\"123\",\"token\":\"opaque\",\"type\":2,\"data\":{\"name\":\"ping\",\"options\":[{\"name\":\"target\",\"value\":\"OW\"}]}}}",
      "{\"type\":\"NONE\",\"data\":{}}"
    ]
    set this.index: 0
    return: 0

  fn poll(timeout_ms):
    if: this.index >= len(this.values)
      return: "{\"type\":\"NONE\",\"data\":{}}"
    set result: this.values[this.index]
    set this.index: this.index + 1
    return: result

class FakeRest:
  field registered
  field restricted
  field options_registered
  field last_autocomplete
  field last_reply
  field last_defer
  field last_followup
  field last_message

  fn new():
    set this.registered: {}
    set this.restricted: {}
    set this.options_registered: {}
    set this.last_autocomplete: ""
    set this.last_reply: ""
    set this.last_defer: 0
    set this.last_followup: ""
    set this.last_message: ""
    return: 0

  fn register_dev_command(name, description):
    call: map_set(this.registered, name, description)
    return: 201

  fn register_dev_command_permissions(name, description, permissions):
    call: map_set(this.restricted, name, permissions)
    return: 201

  fn register_dev_command_options(name, description, options_json, permissions):
    call: map_set(this.options_registered, name, json_parse(options_json))
    return: 201

  fn autocomplete(id, token, choices_json):
    set this.last_autocomplete: choices_json
    return: 204

  fn reply(id, token, content):
    set this.last_reply: content
    return: 204

  fn reply_ephemeral(id, token, content):
    set this.last_reply: content
    return: 204

  fn defer(id, token, private):
    set this.last_defer: private
    return: 204

  fn followup(token, content):
    set this.last_followup: content
    return: 200

  fn followup_ephemeral(token, content):
    set this.last_followup: content
    return: 200

  fn send_message(channel_id, content):
    set this.last_message: content
    return: 201

  fn send_rich(channel_id, message_json):
    set this.last_message: message_json
    return: 201

  fn reply_rich(id, token, message_json):
    set this.last_reply: message_json
    return: 204

  fn reply_rich_private(id, token, message_json):
    set this.last_reply: message_json
    return: 204

  fn update_component(id, token, message_json):
    set this.last_reply: message_json
    return: 204

  fn open_modal(id, token, modal_json):
    set this.last_reply: modal_json
    return: 204

  fn message_create(channel_id, content):
    set this.last_message: content
    return: "12345"

  fn message_get(channel_id, message_id):
    return: "{\"id\":\"12345\",\"channel_id\":\"55\",\"content\":\"hello\",\"author_id\":\"66\",\"timestamp\":\"\",\"edited_timestamp\":\"\",\"pinned\":false}"

  fn message_list(channel_id, cursor, direction, limit):
    return: "[{\"id\":\"12345\",\"channel_id\":\"55\",\"content\":\"hello\",\"author_id\":\"66\",\"timestamp\":\"\",\"edited_timestamp\":\"\",\"pinned\":false}]"

  fn message_edit(channel_id, message_id, content):
    set this.last_message: content
    return: "{\"id\":\"12345\",\"channel_id\":\"55\",\"content\":\"edited\",\"author_id\":\"66\",\"timestamp\":\"\",\"edited_timestamp\":\"\",\"pinned\":false}"

  fn message_delete(channel_id, message_id):
    return: 204

  fn reaction_add(channel_id, message_id, emoji):
    return: 204

  fn reaction_remove(channel_id, message_id, emoji):
    return: 204

  fn reaction_users(channel_id, message_id, emoji, after, limit):
    return: "[\"66\"]"

  fn guild_get(guild_id):
    return: "{\"id\":\"111\",\"name\":\"OWCord test guild\",\"owner_id\":\"222\",\"description\":\"\",\"member_count\":0}"

  fn guild_channels(guild_id):
    return: "[{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"general\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}]"

  fn channel_get(channel_id):
    return: "{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"general\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"

  fn guild_roles(guild_id):
    return: "[{\"id\":\"444\",\"name\":\"Tester\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}]"

  fn guild_member(guild_id, user_id):
    return: "{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false}"

  fn guild_members(guild_id, after_id, limit):
    return: "[{\"user_id\":\"222\",\"nick\":\"\",\"joined_at\":\"\",\"roles\":[\"444\"],\"pending\":false}]"

  fn guild_channel_create(guild_id, name, topic, reason):
    return: "{\"id\":\"555\",\"guild_id\":\"111\",\"name\":\"new\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"

  fn channel_edit(channel_id, name, topic, reason):
    return: "{\"id\":\"333\",\"guild_id\":\"111\",\"name\":\"renamed\",\"topic\":\"\",\"parent_id\":\"\",\"type\":0,\"position\":0,\"nsfw\":false}"

  fn channel_delete(channel_id, reason):
    return: 204

  fn guild_role_create(guild_id, name, reason):
    return: "{\"id\":\"666\",\"name\":\"Safe\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}"

  fn guild_role_edit(guild_id, role_id, name, reason):
    return: "{\"id\":\"444\",\"name\":\"Updated\",\"permissions\":\"0\",\"position\":1,\"managed\":false,\"mentionable\":false}"

  fn guild_role_delete(guild_id, role_id, reason):
    return: 204

  fn guild_member_role_add(guild_id, user_id, role_id, reason):
    return: 204

  fn guild_member_role_remove(guild_id, user_id, role_id, reason):
    return: 204

@Test
fn syncsAndRoutesCommandsWithMockTransport():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  call: assert(bot.command("ping", "Check latency", "ping_handler") == 1)
  call: assert(bot.command("hello", "Private greeting", "hello_handler") == 1)
  call: assert(bot.command("ping", "Duplicate", "other") == 0)
  call: assert(bot.command_count() == 2)
  call: assert(bot.sync_dev_commands() == 1)
  call: assert(map_get(rest.registered, "ping", "") == "Check latency")
  call: assert(map_get(rest.registered, "hello", "") == "Private greeting")

  set ready: bot.next(0)
  call: assert(ready.kind == "ready")
  set action: bot.next(0)
  call: assert(action.kind == "command")
  call: assert(action.handler == "ping_handler")
  call: assert(action.id == "123")
  call: assert(bot.option(action, "target", "") == "OW")
  call: assert(bot.reply(action, "Pong!") == 204)
  call: assert(rest.last_reply == "Pong!")
  set idle: bot.next(0)
  call: assert(idle.kind == "none")

@Test
fn forwardsPrivateAndDeferredResponses():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  set event: {id: "123", token: "opaque"}
  call: assert(bot.reply_private(event, "secret reply") == 204)
  call: assert(rest.last_reply == "secret reply")
  call: assert(bot.defer(event, 1) == 204)
  call: assert(rest.last_defer == 1)
  call: assert(bot.followup(event, "done") == 200)
  call: assert(rest.last_followup == "done")
  call: assert(bot.followup_private(event, "private done") == 200)
  call: assert(rest.last_followup == "private done")
  call: assert(bot.send_message("123", "hello") == 201)
  call: assert(rest.last_message == "hello")

@Test
fn forwardsRichMessagesAndModalInteractions():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  set event: {id: "123", token: "opaque"}
  set rich: "{\"content\":\"hello\"}"
  set modal: "{\"custom_id\":\"form\",\"title\":\"Form\",\"components\":[]}"
  call: assert(bot.send_rich("456", rich) == 201)
  call: assert(rest.last_message == rich)
  call: assert(bot.reply_rich(event, rich) == 204)
  call: assert(rest.last_reply == rich)
  call: assert(bot.reply_rich_private(event, rich) == 204)
  call: assert(rest.last_reply == rich)
  call: assert(bot.update_message(event, rich) == 204)
  call: assert(rest.last_reply == rich)
  call: assert(bot.show_modal(event, modal) == 204)
  call: assert(rest.last_reply == modal)

@Test
fn synchronizesRestrictedCommandsWithoutChangingExistingOnes():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  call: assert(bot.command("ping", "Public status", "ping") == 1)
  call: assert(bot.command_permissions("moderate", "Moderator action", "mod", "8192") == 1)
  call: assert(bot.command_permissions("moderate", "Duplicate", "other", "8192") == 0)
  call: assert(bot.command_permissions("bad", "Missing bitfield", "bad", "") == 0)
  call: assert(bot.command_count() == 2)
  call: assert(bot.sync_dev_commands() == 1)
  call: assert(map_get(rest.registered, "ping", "") == "Public status")
  call: assert(map_get(rest.restricted, "moderate", "") == "8192")

@Test
fn synchronizesTypedCommandsAndAutocompleteCallbacks():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  set opts: [{type: 3, name: "query", description: "Search query", required: true, autocomplete: true}]
  call: assert(bot.command_options("search", "Search records", "search_handler", opts) == 1)
  call: assert(bot.command_options_permissions("restricted", "Restricted search", "restricted_handler", opts, "8192") == 1)
  call: assert(bot.subcommand_handler("search", "find", "find_handler") == 1)
  call: assert(bot.sync_dev_commands() == 1)
  call: assert(map_get(rest.options_registered, "search", [])[0].name == "query")
  call: assert(map_get(rest.options_registered, "restricted", [])[0].autocomplete == true)
  set event: {id: "1", token: "opaque"}
  set choices: [{name: "Alpha", value: "alpha"}]
  call: assert(bot.autocomplete(event, choices) == 204)
  call: assert(json_parse(rest.last_autocomplete)[0].value == "alpha")


@Test
fn managesMessagesAndReactionsThroughFakeTransport():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  set id: bot.message_create("55", "hello")
  call: assert(id == "12345")
  set msg: bot.message_get("55", id)
  call: assert(msg.id == id)
  call: assert(msg.content == "hello")
  set page: bot.message_list("55", "", "before", 10)
  call: assert(len(page) == 1)
  call: assert(page[0].id == id)
  set edited: bot.message_edit("55", id, "edited")
  call: assert(edited.content == "edited")
  call: assert(rest.last_message == "edited")
  call: assert(bot.reaction_add("55", id, "👍") == 204)
  set users: bot.reaction_users("55", id, "👍", "", 10)
  call: assert(len(users) == 1)
  call: assert(users[0] == "66")
  call: assert(bot.reaction_remove("55", id, "👍") == 204)
  call: assert(bot.message_delete("55", id) == 204)

@Test
fn guildRoleChannelAndMemberFacadeUsesExactIds():
  set gateway: new FakeGateway()
  set rest: new FakeRest()
  set bot: new OWCordClient(gateway, rest)
  set guild: bot.guild_get("111")
  call: assert(guild.id == "111")
  call: assert(guild.name == "OWCord test guild")
  set channels: bot.guild_channels("111")
  call: assert(len(channels) == 1)
  call: assert(channels[0].name == "general")
  call: assert(bot.channel_get("333").id == "333")
  set roles: bot.guild_roles("111")
  call: assert(roles[0].permissions == "0")
  call: assert(bot.guild_member("111", "222").user_id == "222")
  call: assert(bot.guild_members("111", "", 10)[0].roles[0] == "444")
  set created_channel: bot.guild_channel_create("111", "new", "", "OWCord test")
  call: assert(created_channel.id == "555")
  call: assert(bot.channel_edit("333", "renamed", "", "OWCord test").name == "renamed")
  call: assert(bot.channel_delete("333", "OWCord test") == 204)
  set new_role: bot.guild_role_create("111", "Safe", "OWCord test")
  call: assert(new_role.permissions == "0")
  call: assert(bot.guild_role_edit("111", "444", "Updated", "OWCord test").name == "Updated")
  call: assert(bot.guild_role_delete("111", "444", "OWCord test") == 204)
  call: assert(bot.guild_member_role_add("111", "222", "444", "OWCord test") == 204)
  call: assert(bot.guild_member_role_remove("111", "222", "444", "OWCord test") == 204)
