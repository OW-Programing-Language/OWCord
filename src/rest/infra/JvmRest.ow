module OWCord.JvmRest: DISCORD_REST
  fn name() -> string:
    return: "rest"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: 0
  fn stop() -> int:
    return: 0
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn register_dev_command(name string, description string) -> int:
    return: extension("owcord.rest.dev_command", name, description)
  fn reply(interaction_id string, interaction_token string, content string) -> int:
    return: extension("owcord.rest.reply", interaction_id, interaction_token, content)
  fn send_message(channel_id string, content string) -> int:
    return: extension("owcord.rest.message", channel_id, content)
  fn reply_ephemeral(interaction_id string, interaction_token string, content string) -> int:
    return: extension("owcord.rest.reply_private", interaction_id, interaction_token, content)
  fn defer(interaction_id string, interaction_token string, private int) -> int:
    return: extension("owcord.rest.defer", interaction_id, interaction_token, private)
  fn followup(interaction_token string, content string) -> int:
    return: extension("owcord.rest.followup", interaction_token, content)
  fn followup_ephemeral(interaction_token string, content string) -> int:
    return: extension("owcord.rest.followup_private", interaction_token, content)
  fn send_rich(channel_id string, message_json string) -> int:
    return: extension("owcord.rest.send_rich", channel_id, message_json)
  fn reply_rich(interaction_id string, interaction_token string, message_json string) -> int:
    return: extension("owcord.rest.reply_rich", interaction_id, interaction_token, message_json)
  fn reply_rich_private(interaction_id string, interaction_token string, message_json string) -> int:
    return: extension("owcord.rest.reply_rich_private", interaction_id, interaction_token, message_json)
  fn update_component(interaction_id string, interaction_token string, message_json string) -> int:
    return: extension("owcord.rest.update_component", interaction_id, interaction_token, message_json)
  fn open_modal(interaction_id string, interaction_token string, modal_json string) -> int:
    return: extension("owcord.rest.open_modal", interaction_id, interaction_token, modal_json)
  fn register_dev_command_permissions(name string, description string, permissions string) -> int:
    return: extension("owcord.rest.dev_command_permissions", name, description, permissions)
  fn register_dev_command_options(name string, description string, options_json string, permissions string) -> int:
    return: extension("owcord.rest.dev_command_options", name, description, options_json, permissions)
  fn autocomplete(interaction_id string, interaction_token string, choices_json string) -> int:
    return: extension("owcord.rest.autocomplete", interaction_id, interaction_token, choices_json)
  fn message_create(channel_id string, content string) -> string:
    return: extension("owcord.rest.message_create", channel_id, content)
  fn message_get(channel_id string, message_id string) -> string:
    return: extension("owcord.rest.message_get", channel_id, message_id)
  fn message_list(channel_id string, cursor string, direction string, limit int) -> string:
    return: extension("owcord.rest.message_list", channel_id, cursor, direction, limit)
  fn message_edit(channel_id string, message_id string, content string) -> string:
    return: extension("owcord.rest.message_edit", channel_id, message_id, content)
  fn message_delete(channel_id string, message_id string) -> int:
    return: extension("owcord.rest.message_delete", channel_id, message_id)
  fn reaction_add(channel_id string, message_id string, emoji string) -> int:
    return: extension("owcord.rest.reaction_add", channel_id, message_id, emoji)
  fn reaction_remove(channel_id string, message_id string, emoji string) -> int:
    return: extension("owcord.rest.reaction_remove", channel_id, message_id, emoji)
  fn reaction_users(channel_id string, message_id string, emoji string, after string, limit int) -> string:
    return: extension("owcord.rest.reaction_users", channel_id, message_id, emoji, after, limit)
