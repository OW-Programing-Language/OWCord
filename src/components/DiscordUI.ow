# Pure-OW builders for Discord v0.3 rich messages and interactive components.
# Validated/sanitized again by the runtime bridge before being sent to Discord.
class DiscordUI:
  fn new():
    return: 0

  fn message(content, embeds, components):
    return: json({content: content, embeds: embeds, components: components})

  fn embed(title, description, color):
    return: {title: title, description: description, color: color}

  fn row(components):
    return: {type: 1, components: components}

  # style 1=primary, 2=secondary, 3=success, 4=danger.
  fn button(id, label, style):
    return: {type: 2, custom_id: id, label: label, style: style}

  fn option(label, value, description):
    return: {label: label, value: value, description: description}

  # A single-choice string select, placed alone in its action row.
  fn select(id, placeholder, options):
    return: {type: 3, custom_id: id, placeholder: placeholder, options: options}

  # Discord modal callback with Label (type 18) wrappers.
  fn modal(id, title, labels):
    return: json({custom_id: id, title: title, components: labels})

  fn label(text, component):
    return: {type: 18, label: text, component: component}

  # style 1=short, 2=paragraph. Required is a boolean.
  fn text_input(id, placeholder, style, required):
    return: {type: 4, custom_id: id, placeholder: placeholder, style: style, required: required}

  # Components V2 messages cannot contain legacy content or embeds.
  fn v2_message(components):
    return: json({flags: 32768, components: components})

  fn v2_text(content):
    return: {type: 10, content: content}

  fn v2_separator(divider, spacing):
    return: {type: 14, divider: divider, spacing: spacing}

  # Accent: 0..16777215; use -1 to omit the color.
  fn v2_container(children, accent_color):
    if: accent_color < 0
      return: {type: 17, components: children}
    return: {type: 17, components: children, accent_color: accent_color}

  fn v2_section(text_displays, accessory):
    return: {type: 9, components: text_displays, accessory: accessory}

  fn v2_thumbnail(https_url):
    return: {type: 11, media: {url: https_url}}

  fn v2_gallery(items):
    return: {type: 12, items: items}

  fn v2_media_item(https_url, description, spoiler):
    return: {media: {url: https_url}, description: description, spoiler: spoiler}
