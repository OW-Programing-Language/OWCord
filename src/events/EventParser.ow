# Interpreter-side typed event normalization.
# No bot secrets are persisted or logged here.
class EventParser:
  fn new():
    return: 0

  fn decode(raw):
    set envelope: json_parse(raw)
    set event_type: map_get(envelope, "type", "NONE")
    set data: map_get(envelope, "data", {})
    set event: {kind: "other", name: "", handler: "", id: "", token: "", guild_id: "", channel_id: "", user_id: "", custom_id: "", content: "", options: [], values: [], fields: [], action: "", member_permissions: "", app_permissions: "", payload: data}

    if: event_type == "NONE"
      call: map_set(event, "kind", "none")
      return: event
    if: event_type == "READY"
      call: map_set(event, "kind", "ready")
      return: event
    if: event_type == "ERROR"
      call: map_set(event, "kind", "error")
      return: event
    if: event_type == "RESUMED"
      call: map_set(event, "kind", "ready")
      call: map_set(event, "action", "resumed")
      return: event

    if: event_type == "MESSAGE_UPDATE"
      call: map_set(event, "kind", "message")
      call: map_set(event, "action", "update")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      call: map_set(event, "channel_id", map_get(data, "channel_id", ""))
      call: map_set(event, "content", map_get(data, "content", ""))
      return: event

    if: event_type == "MESSAGE_DELETE"
      call: map_set(event, "kind", "message")
      call: map_set(event, "action", "delete")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      call: map_set(event, "channel_id", map_get(data, "channel_id", ""))
      return: event

    if: event_type == "GUILD_MEMBER_ADD"
      call: map_set(event, "kind", "member")
      call: map_set(event, "action", "add")
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      set user: map_get(data, "user", {})
      call: map_set(event, "user_id", map_get(user, "id", ""))
      return: event

    if: event_type == "GUILD_MEMBER_UPDATE"
      call: map_set(event, "kind", "member")
      call: map_set(event, "action", "update")
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      set user: map_get(data, "user", {})
      call: map_set(event, "user_id", map_get(user, "id", ""))
      return: event

    if: event_type == "GUILD_MEMBER_REMOVE"
      call: map_set(event, "kind", "member")
      call: map_set(event, "action", "remove")
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      set user: map_get(data, "user", {})
      call: map_set(event, "user_id", map_get(user, "id", ""))
      return: event

    if: event_type == "CHANNEL_CREATE"
      call: map_set(event, "kind", "channel")
      call: map_set(event, "action", "create")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      return: event

    if: event_type == "CHANNEL_UPDATE"
      call: map_set(event, "kind", "channel")
      call: map_set(event, "action", "update")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      return: event

    if: event_type == "CHANNEL_DELETE"
      call: map_set(event, "kind", "channel")
      call: map_set(event, "action", "delete")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      return: event

    if: event_type == "GUILD_CREATE"
      call: map_set(event, "kind", "guild")
      call: map_set(event, "action", "create")
      call: map_set(event, "id", map_get(data, "id", ""))
      return: event

    if: event_type == "GUILD_UPDATE"
      call: map_set(event, "kind", "guild")
      call: map_set(event, "action", "update")
      call: map_set(event, "id", map_get(data, "id", ""))
      return: event

    if: event_type == "GUILD_DELETE"
      call: map_set(event, "kind", "guild")
      call: map_set(event, "action", "delete")
      call: map_set(event, "id", map_get(data, "id", ""))
      return: event

    if: event_type == "MESSAGE_CREATE"
      call: map_set(event, "kind", "message")
      call: map_set(event, "action", "create")
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "content", map_get(data, "content", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      call: map_set(event, "channel_id", map_get(data, "channel_id", ""))
      set author: map_get(data, "author", {})
      call: map_set(event, "user_id", map_get(author, "id", ""))
      return: event

    if: event_type == "INTERACTION_CREATE"
      call: map_set(event, "id", map_get(data, "id", ""))
      call: map_set(event, "token", map_get(data, "token", ""))
      call: map_set(event, "guild_id", map_get(data, "guild_id", ""))
      call: map_set(event, "channel_id", map_get(data, "channel_id", ""))
      set member: map_get(data, "member", {})
      call: map_set(event, "member_permissions", map_get(member, "permissions", ""))
      call: map_set(event, "app_permissions", map_get(data, "app_permissions", ""))
      set user: map_get(member, "user", {})
      if: map_get(user, "id", "") == ""
        set user: map_get(data, "user", {})
      call: map_set(event, "user_id", map_get(user, "id", ""))
      set interaction_data: map_get(data, "data", {})
      set interaction_type: map_get(data, "type", 0)
      if: interaction_type == 2
        call: map_set(event, "kind", "command")
        call: map_set(event, "name", map_get(interaction_data, "name", ""))
        call: map_set(event, "options", map_get(interaction_data, "options", []))
      else if: interaction_type == 3
        call: map_set(event, "kind", "component")
        call: map_set(event, "custom_id", map_get(interaction_data, "custom_id", ""))
        call: map_set(event, "values", map_get(interaction_data, "values", []))
      else if: interaction_type == 5
        call: map_set(event, "kind", "modal")
        call: map_set(event, "custom_id", map_get(interaction_data, "custom_id", ""))
        call: map_set(event, "fields", map_get(interaction_data, "components", []))
      else:
        call: map_set(event, "kind", "interaction")
      return: event

    call: map_set(event, "name", event_type)
    return: event

  # Slash command option helper for simple, top-level options.
  fn option(event, name, fallback):
    set options: map_get(event, "options", [])
    set i: 0
    while: i < len(options)
      set option: options[i]
      if: map_get(option, "name", "") == name
        return: map_get(option, "value", fallback)
      set i: i + 1
    return: fallback

  # Supports modern type-18 Label wrappers and legacy type-1 action rows.
  fn modal_value(event, id, fallback):
    set fields: map_get(event, "fields", [])
    set i: 0
    while: i < len(fields)
      set entry: fields[i]
      set kind: map_get(entry, "type", 0)
      if: kind == 18
        set input: map_get(entry, "component", {})
        if: map_get(input, "custom_id", "") == id
          return: map_get(input, "value", fallback)
      else if: kind == 1
        set inputs: map_get(entry, "components", [])
        set j: 0
        while: j < len(inputs)
          set input: inputs[j]
          if: map_get(input, "custom_id", "") == id
            return: map_get(input, "value", fallback)
          set j: j + 1
      set i: i + 1
    return: fallback
