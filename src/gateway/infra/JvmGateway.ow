module OWCord.JvmGateway: DISCORD_GATEWAY
  fn name() -> string:
    return: "gateway"
  fn requires() -> array:
    return: []
  fn register() -> int:
    return: 0
  fn start() -> int:
    return: extension("owcord.gateway.connect")
  fn stop() -> int:
    return: extension("owcord.gateway.disconnect")
  fn reload() -> int:
    return: 0
  fn on_event(type string, payload int) -> int:
    return: 0
  fn connected() -> int:
    return: extension("owcord.gateway.connected")
  fn poll(timeout_ms int) -> string:
    return: extension("owcord.gateway.poll", timeout_ms)
  fn intents() -> string:
    return: extension("owcord.gateway.intents")
  fn cache_stats() -> string:
    return: extension("owcord.gateway.cache_stats")
  fn cache_guild(id string) -> string:
    return: extension("owcord.gateway.cache_guild", id)
  fn cache_channel(id string) -> string:
    return: extension("owcord.gateway.cache_channel", id)
  fn cache_member(guild_id string, user_id string) -> string:
    return: extension("owcord.gateway.cache_member", guild_id, user_id)
  fn cache_clear() -> int:
    return: extension("owcord.gateway.cache_clear")
  fn shard_config() -> string:
    return: extension("owcord.gateway.shard_config")
  fn shard_status() -> string:
    return: extension("owcord.gateway.shard_status")
