# Convenient OW SDK facade; transport and lifecycle remain flOW managed.
import "../events/EventParser.ow"
import "../commands/CommandRouter.ow"

class OWCordClient:
  field gateway
  field rest
  field parser
  field router

  fn new(gateway, rest):
    set this.gateway: gateway
    set this.rest: rest
    set this.parser: new EventParser()
    set this.router: new CommandRouter()
    return: 0

  fn command(name, description, handler):
    return: this.router.add(name, description, handler)

  fn command_permissions(name, description, handler, required_permissions):
    return: this.router.add_permissions(name, description, handler, required_permissions)

  # Returns int 1 or 0. Missing member permissions fail closed.
  fn member_can(event, required_permissions):
    set granted: map_get(event, "member_permissions", "")
    return: extension("owcord.permissions.has", granted, required_permissions)

  fn command_options(name, description, handler, options):
    return: this.router.add_options(name, description, handler, options)

  fn command_options_permissions(name, description, handler, options, required_permissions):
    return: this.router.add_options_permissions(name, description, handler, options, required_permissions)

  fn subcommand_handler(name, path, handler):
    return: this.router.route(name, path, handler)

  # Registers a global command with explicit installation/invocation contexts.
  # E.g. GUILD_INSTALL=0, USER_INSTALL=1; GUILD=0, BOT_DM=1, PRIVATE_CHANNEL=2.
  fn command_global(name, description, handler, contexts, installs):
    return: this.router.add_global(name, description, handler, contexts, installs)

  fn command_count():
    return: this.router.count()

  # Registers without overwriting unrelated guild commands.
  # Discord returns 200 when updating an existing command and 201 on create.
  fn sync_dev_commands():
    set names: this.router.names()
    set i: 0
    while: i < len(names)
      set name: names[i]
      set required: this.router.permissions(name)
      set status: 0
      set schema: this.router.options(name)
      set scope: this.router.global_scope(name)
      if: map_has(scope, "contexts")
        set status: this.rest.register_global_context_command(name, this.router.description(name), json(scope.contexts), json(scope.integrations))
      else if: schema != ""
        set status: this.rest.register_dev_command_options(name, this.router.description(name), schema, required)
      else if: required == ""
        set status: this.rest.register_dev_command(name, this.router.description(name))
      else:
        set status: this.rest.register_dev_command_permissions(name, this.router.description(name), required)
      if: status != 200
        if: status != 201
          return: 0
      set i: i + 1
    return: 1

  fn next(timeout_ms):
    set event: this.parser.decode(this.gateway.poll(timeout_ms))
    return: this.router.dispatch(event)

  fn option(event, name, fallback):
    return: this.parser.option(event, name, fallback)

  fn reply(event, content):
    return: this.rest.reply(event.id, event.token, content)

  fn reply_private(event, content):
    return: this.rest.reply_ephemeral(event.id, event.token, content)

  fn defer(event, private):
    return: this.rest.defer(event.id, event.token, private)

  fn followup(event, content):
    return: this.rest.followup(event.token, content)

  fn followup_private(event, content):
    return: this.rest.followup_ephemeral(event.token, content)

  fn send_message(channel_id, content):
    return: this.rest.send_message(channel_id, content)
  fn send_rich(channel_id, message_json):
    return: this.rest.send_rich(channel_id, message_json)

  fn reply_rich(event, message_json):
    return: this.rest.reply_rich(event.id, event.token, message_json)

  fn reply_rich_private(event, message_json):
    return: this.rest.reply_rich_private(event.id, event.token, message_json)

  fn update_message(event, message_json):
    return: this.rest.update_component(event.id, event.token, message_json)

  fn show_modal(event, modal_json):
    return: this.rest.open_modal(event.id, event.token, modal_json)

  # Components V2 and interaction response editing/deleting.
  fn v2_create(channel_id, payload_json):
    return: this.rest.v2_create(channel_id, payload_json)

  fn v2_reply(event, payload_json, private):
    return: this.rest.v2_reply(event.id, event.token, payload_json, private)

  fn v2_update(event, payload_json):
    return: this.rest.v2_update(event.id, event.token, payload_json)

  fn v2_followup(event, payload_json, private):
    return: this.rest.v2_followup(event.token, payload_json, private)

  fn defer_component_update(event):
    return: this.rest.defer_component_update(event.id, event.token)

  fn edit_original(event, content):
    return: json_parse(this.rest.edit_original(event.token, content))

  fn delete_original(event):
    return: this.rest.delete_original(event.token)

  fn edit_followup(event, message_id, content):
    return: json_parse(this.rest.edit_followup(event.token, message_id, content))

  fn delete_followup(event, message_id):
    return: this.rest.delete_followup(event.token, message_id)

  fn modal_value(event, id, fallback):
    return: this.parser.modal_value(event, id, fallback)

  # Callback type 8; autocomplete interactions must not receive a normal reply.
  fn autocomplete(event, choices):
    return: this.rest.autocomplete(event.id, event.token, json(choices))

  # v0.7: exact snowflake IDs are strings, never OW floating-point numbers.
  fn message_create(channel_id, content):
    return: this.rest.message_create(channel_id, content)

  fn message_get(channel_id, message_id):
    return: json_parse(this.rest.message_get(channel_id, message_id))

  # cursor "" means the first page; direction is "before" or "after".
  fn message_list(channel_id, cursor, direction, limit):
    return: json_parse(this.rest.message_list(channel_id, cursor, direction, limit))

  fn message_edit(channel_id, message_id, content):
    return: json_parse(this.rest.message_edit(channel_id, message_id, content))

  fn message_delete(channel_id, message_id):
    return: this.rest.message_delete(channel_id, message_id)

  fn reaction_add(channel_id, message_id, emoji):
    return: this.rest.reaction_add(channel_id, message_id, emoji)

  fn reaction_remove(channel_id, message_id, emoji):
    return: this.rest.reaction_remove(channel_id, message_id, emoji)

  fn reaction_users(channel_id, message_id, emoji, after, limit):
    return: json_parse(this.rest.reaction_users(channel_id, message_id, emoji, after, limit))
  fn guild_get(guild_id):
    return: json_parse(this.rest.guild_get(guild_id))

  fn guild_channels(guild_id):
    return: json_parse(this.rest.guild_channels(guild_id))

  fn channel_get(channel_id):
    return: json_parse(this.rest.channel_get(channel_id))

  fn guild_roles(guild_id):
    return: json_parse(this.rest.guild_roles(guild_id))

  fn guild_member(guild_id, user_id):
    return: json_parse(this.rest.guild_member(guild_id, user_id))

  fn guild_members(guild_id, after_id, limit):
    return: json_parse(this.rest.guild_members(guild_id, after_id, limit))

  fn guild_channel_create(guild_id, name, topic, reason):
    return: json_parse(this.rest.guild_channel_create(guild_id, name, topic, reason))

  fn channel_edit(channel_id, name, topic, reason):
    return: json_parse(this.rest.channel_edit(channel_id, name, topic, reason))

  fn channel_delete(channel_id, reason):
    return: this.rest.channel_delete(channel_id, reason)

  fn guild_role_create(guild_id, name, reason):
    return: json_parse(this.rest.guild_role_create(guild_id, name, reason))

  fn guild_role_edit(guild_id, role_id, name, reason):
    return: json_parse(this.rest.guild_role_edit(guild_id, role_id, name, reason))

  fn guild_role_delete(guild_id, role_id, reason):
    return: this.rest.guild_role_delete(guild_id, role_id, reason)

  fn guild_member_role_add(guild_id, user_id, role_id, reason):
    return: this.rest.guild_member_role_add(guild_id, user_id, role_id, reason)

  fn guild_member_role_remove(guild_id, user_id, role_id, reason):
    return: this.rest.guild_member_role_remove(guild_id, user_id, role_id, reason)
  # Snapshot-based permission helpers. Discord's server remains authoritative.
  fn effective_permissions(guild_id, user_id, channel_id):
    set guild: this.guild_get(guild_id)
    set member: this.guild_member(guild_id, user_id)
    set channel: this.channel_get(channel_id)
    set roles: this.guild_roles(guild_id)
    return: this.rest.permission_effective(json(guild), json(member), json(channel), json(roles))

  fn has_permission(granted, required):
    return: extension("owcord.permissions.has", granted, required)

  # Authorization preflight only; does not mutate Discord.
  fn can_moderate(guild_id, actor_id, target_id, action):
    set guild: this.guild_get(guild_id)
    set actor: this.guild_member(guild_id, actor_id)
    # Banned users are no longer members; unbanning checks only actor rights.
    set target: {user_id: target_id, roles: []}
    if: action != "unban"
      set target: this.guild_member(guild_id, target_id)
    set roles: this.guild_roles(guild_id)
    return: this.rest.permission_can_moderate(json(guild), json(actor), json(target), json(roles), action)

  fn can_manage_role(guild_id, actor_id, role_id):
    set guild: this.guild_get(guild_id)
    set actor: this.guild_member(guild_id, actor_id)
    set roles: this.guild_roles(guild_id)
    return: this.rest.permission_role_manageable(json(guild), json(actor), role_id, json(roles))

  # Explicit audited moderation; use can_moderate on the requesting user first.
  fn moderation_kick(guild_id, user_id, reason):
    return: this.rest.moderation_kick(guild_id, user_id, reason)

  fn moderation_ban(guild_id, user_id, delete_message_seconds, reason):
    return: this.rest.moderation_ban(guild_id, user_id, delete_message_seconds, reason)

  fn moderation_unban(guild_id, user_id, reason):
    return: this.rest.moderation_unban(guild_id, user_id, reason)

  fn moderation_timeout(guild_id, user_id, until_iso, reason):
    return: json_parse(this.rest.moderation_timeout(guild_id, user_id, until_iso, reason))

  fn moderation_clear_timeout(guild_id, user_id, reason):
    return: json_parse(this.rest.moderation_clear_timeout(guild_id, user_id, reason))
