# Deterministic command registry and handler-name dispatch in pure OW.
# Handler names are labels, not dynamically invoked code: user logic chooses them.
class CommandRouter:
  field handlers
  field descriptions
  field command_permissions
  field command_schemas
  field routes
  field global_scopes

  fn new():
    set this.handlers: {}
    set this.descriptions: {}
    set this.command_permissions: {}
    set this.command_schemas: {}
    set this.routes: {}
    set this.global_scopes: {}
    return: 0

  fn add(name, description, handler):
    if: name == ""
      return: 0
    if: description == ""
      return: 0
    if: handler == ""
      return: 0
    if: map_has(this.handlers, name)
      return: 0
    if: map_size(this.handlers) >= 32
      return: 0
    call: map_set(this.handlers, name, handler)
    call: map_set(this.descriptions, name, description)
    return: 1

  # Permissions are decimal strings: Discord can exceed OW's 32-bit range.
  # Empty means unrestricted; "0" disables by default until guild overrides.
  fn add_permissions(name, description, handler, required_permissions):
    if: required_permissions == ""
      return: 0
    set added: this.add(name, description, handler)
    if: added == 1
      call: map_set(this.command_permissions, name, required_permissions)
    return: added

  # The bridge validates typed JSON schemas before sending to Discord.
  fn add_options(name, description, handler, options):
    set added: this.add(name, description, handler)
    if: added == 1
      call: map_set(this.command_schemas, name, json(options))
    return: added

  fn add_options_permissions(name, description, handler, options, required_permissions):
    if: required_permissions == ""
      return: 0
    set added: this.add_options(name, description, handler, options)
    if: added == 1
      call: map_set(this.command_permissions, name, required_permissions)
    return: added

  # Define route handlers for e.g. "ban" or "users ban".
  # Base handler remains the fallback for unknown nested routes.
  fn route(name, path, handler):
    if: path == ""
      return: 0
    if: handler == ""
      return: 0
    if: map_has(this.handlers, name) == false
      return: 0
    set key: name + ":" + path
    if: map_has(this.routes, key)
      return: 0
    call: map_set(this.routes, key, handler)
    return: 1

  fn options(name):
    return: map_get(this.command_schemas, name, "")

  fn add_global(name, description, handler, contexts, installs):
    set added: this.add(name, description, handler)
    if: added == 1
      call: map_set(this.global_scopes, name, {contexts: contexts, integrations: installs})
    return: added

  fn global_scope(name):
    return: map_get(this.global_scopes, name, {})

  fn permissions(name):
    return: map_get(this.command_permissions, name, "")

  fn names():
    return: map_keys(this.handlers)

  fn count():
    return: map_size(this.handlers)

  fn description(name):
    return: map_get(this.descriptions, name, "")

  fn dispatch(event):
    if: event.kind != "command"
      if: event.kind != "autocomplete"
        return: event
    set handler: map_get(this.handlers, event.name, "")
    set path: map_get(event, "path", "")
    if: path != ""
      set handler: map_get(this.routes, event.name + ":" + path, handler)
    call: map_set(event, "handler", handler)
    return: event
