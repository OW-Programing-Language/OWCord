DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-guild-id
DISCORD_TEST_CHANNEL_ID=replace-with-dedicated-text-channel-id
OWCORD_GATEWAY_INTENTS=1
# Optional. Can also use named comma-separated intents, e.g. GUILDS,GUILD_MESSAGES.
# Privileged intents (GUILD_MEMBERS, GUILD_PRESENCES, MESSAGE_CONTENT)
# require enabling/approval in the Discord Developer Portal.
# OWCORD_GATEWAY_INTENTS=GUILDS,GUILD_MESSAGES

# Optional Gateway metadata cache. Default OFF for privacy.
OWCORD_CACHE_MODE=off
OWCORD_CACHE_MAX_ENTRIES=256
OWCORD_CACHE_TTL_SECONDS=300
