DISCORD_BOT_TOKEN=replace-with-bot-token
DISCORD_APPLICATION_ID=replace-with-application-id
DISCORD_GUILD_ID=replace-with-guild-id
DISCORD_TEST_CHANNEL_ID=replace-with-dedicated-text-channel-id
OWCORD_GATEWAY_INTENTS=1
# Optional. Can also use named comma-separated intents, e.g. GUILDS,GUILD_MESSAGES.
# Privileged intents (GUILD_MEMBERS, GUILD_PRESENCES, MESSAGE_CONTENT)
# require enabling/approval in the Discord Developer Portal.
# OWCORD_GATEWAY_INTENTS=GUILDS,GUILD_MESSAGES

# Optional Gateway metadata cache. Default OFF for privacy.
OWCORD_CACHE_MODE=off
OWCORD_CACHE_MAX_ENTRIES=256
OWCORD_CACHE_TTL_SECONDS=300
# v0.12 multi-shard Gateway: default singleton. Max 64 shards per interpreter.
# A single OW interpreter may own several shard IDs. Never run independent
# processes with the same token without external Identify coordination.
OWCORD_SHARD_COUNT=1
OWCORD_SHARD_IDS=0

# Daily reward storage: sqlite (default on fresh installs), json, postgresql, mysql, mariadb, mongodb.
# Omit OWCORD_STORAGE to automatically preserve an existing JSON claim directory.
# OWCORD_STORAGE=sqlite
# OWCORD_DATA_DIR=.owcord-data
# OWCORD_STORAGE_SQLITE_PATH=.owcord-data/daily-rewards.db
# OWCORD_STORAGE_JDBC_URL=jdbc:postgresql://localhost:5432/owcord
# OWCORD_STORAGE_USER=owcord
# OWCORD_STORAGE_PASSWORD=replace-with-database-password
# OWCORD_STORAGE_MONGO_URI=mongodb://localhost:27017
# OWCORD_STORAGE_MONGO_DATABASE=owcord
