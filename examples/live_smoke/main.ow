# Real Discord smoke test. Intentionally posts one message in a designated test channel.
# Requires DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID, DISCORD_GUILD_ID,
# DISCORD_TEST_CHANNEL_ID and OWCORD_GATEWAY_INTENTS=513 (GUILDS + GUILD_MESSAGES).
import "@flow/src/App.ow"
import "../../src/gateway/api/GatewayApi.ow"
import "../../src/gateway/infra/JvmGateway.ow"
import "../../src/rest/api/RestApi.ow"
import "../../src/rest/infra/JvmRest.ow"

main:
  set app: new App()
  call: app.use_native_as(OWCord.JvmGateway, "DISCORD_GATEWAY")
  call: app.use_native_as(OWCord.JvmRest, "DISCORD_REST")
  call: assert(app.boot() == 1, "live smoke: boot")

  set gateway DISCORD_GATEWAY: app.service("gateway")
  set rest DISCORD_REST: app.service("rest")

  set ready: 0
  set attempts: 0
  while: attempts < 60
    set event: json_parse(gateway.poll(1000))
    if: event.type == "READY"
      set ready: 1
      set attempts: 60
    else if: event.type == "ERROR"
      throw: "live smoke: Gateway rejected credentials or intents"
    else:
      set attempts: attempts + 1
  call: assert(ready == 1, "live smoke: READY timeout")
  print: "LIVE PASS: Discord Gateway READY"

  set registered: rest.register_dev_command("ping", "Replies with Pong from OW")
  if: registered != 200
    call: assert(registered == 201, "live smoke: register /ping")
  print: "LIVE PASS: /ping registered in development guild"

  set channel: extension("owcord.test.channel_id")
  set marker: "OWCord live smoke " + str(time_ms())
  set sent: rest.send_message(channel, marker)
  if: sent != 200
    call: assert(sent == 201, "live smoke: REST message send")
  print: "LIVE PASS: Discord REST message created"

  set received: 0
  set attempts: 0
  while: attempts < 60
    set event: json_parse(gateway.poll(1000))
    if: event.type == "MESSAGE_CREATE"
      if: event.data.content == marker
        set received: 1
        set attempts: 60
      else:
        set attempts: attempts + 1
    else if: event.type == "ERROR"
      throw: "live smoke: Gateway disconnected"
    else:
      set attempts: attempts + 1
  call: assert(received == 1, "live smoke: MESSAGE_CREATE not received")
  print: "LIVE PASS: matching MESSAGE_CREATE received via Gateway"
  call: assert(app.stop() == 1, "live smoke: disconnect")
  print: "LIVE SMOKE COMPLETE: Discord authentication, Gateway, REST and event delivery"
