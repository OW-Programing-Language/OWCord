# Live Discord integration test for the v0.2 OW-native command router and event parser.
# Uses a real bot token from the GitHub Actions secret, never from source code.
# Creates/updates two slash commands and sends one marked message to a test channel.
# Requires DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID, DISCORD_GUILD_ID,
# DISCORD_TEST_CHANNEL_ID and OWCORD_GATEWAY_INTENTS=513.
import "@flow/src/App.ow"
import "../../src/gateway/api/GatewayApi.ow"
import "../../src/gateway/infra/JvmGateway.ow"
import "../../src/rest/api/RestApi.ow"
import "../../src/rest/infra/JvmRest.ow"
import "../../src/client/OWCordClient.ow"
import "../../src/commands/CommandOptions.ow"
import "../../src/components/DiscordUI.ow"

main:
  set app: new App()
  call: app.use_native_as(OWCord.JvmGateway, "DISCORD_GATEWAY")
  call: app.use_native_as(OWCord.JvmRest, "DISCORD_REST")
  call: assert(app.boot() == 1, "live v0.2: flOW boot")

  set gateway DISCORD_GATEWAY: app.service("gateway")
  set rest DISCORD_REST: app.service("rest")
  set bot: new OWCordClient(gateway, rest)

  call: assert(bot.command("ping", "Replies with Pong from OW", "ping_handler") == 1, "live v0.2: add ping")
  call: assert(bot.command("hello", "Say hello in private", "hello_handler") == 1, "live v0.2: add hello")
  call: assert(bot.command("ping", "Duplicate", "other_handler") == 0, "live v0.2: reject duplicate")
  call: assert(bot.command_count() == 2, "live v0.2: registry count")
  print: "LIVE PASS: flOW lifecycle and OW command router"

  set ready: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "ready"
      set ready: 1
      set attempts: 60
    else if: event.kind == "error"
      throw: "live v0.2: Discord Gateway error before READY"
    else:
      set attempts: attempts + 1
  call: assert(ready == 1, "live v0.2: READY timeout")
  call: assert(gateway.connected() == 1, "live v0.2: active connection")
  print: "LIVE PASS: Discord Gateway READY parsed by OW EventParser"

  # v0.6: register one real typed slash command with autocomplete metadata.
  set builder: new CommandOptions()
  set search_schema: [builder.string_option("query", "Search a sample name", true, true)]
  call: assert(bot.command_options("owdemo6", "v0.6 live option registration", "demo_handler", search_schema) == 1, "live v0.6: register option schema")
  call: assert(bot.sync_dev_commands() == 1, "live v0.2: register /ping and /hello")
  print: "LIVE PASS: OW CommandRouter registered /ping, /hello and typed /owdemo6 via Discord REST"

  set channel: extension("owcord.test.channel_id")
  set marker: "OWCord v0.2 live smoke " + str(time_ms())
  set sent: bot.send_message(channel, marker)
  if: sent != 200
    call: assert(sent == 201, "live v0.2: send test message")
  print: "LIVE PASS: Discord REST accepted a real message"

  set received: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "message"
      if: event.content == marker
        call: assert(event.channel_id == channel, "live v0.2: channel id")
        call: assert(event.id != "", "live v0.2: message snowflake id")
        call: assert(event.user_id != "", "live v0.2: author id")
        set received: 1
        set attempts: 60
      else:
        set attempts: attempts + 1
    else if: event.kind == "error"
      throw: "live v0.2: Gateway error while waiting for message"
    else:
      set attempts: attempts + 1
  call: assert(received == 1, "live v0.2: matching MESSAGE_CREATE not received")
  print: "LIVE PASS: real MESSAGE_CREATE normalized with channel, author and message IDs"

  # v0.3 real Discord message with OW embed + interactive components.
  set ui: new DiscordUI()
  set rich_marker: "OWCord v0.3 rich smoke " + str(time_ms())
  set embed: ui.embed("OWCord rich smoke", "Embeds and components from native OW source", 5793266)
  set buttons: ui.row([ui.button("owcord_smoke_button", "Click to test", 1)])
  set select: ui.row([ui.select("owcord_smoke_select", "Select a color", [ui.option("Blue", "blue", "Option A"), ui.option("Green", "green", "Option B")])])
  set rich_status: bot.send_rich(channel, ui.message(rich_marker, [embed], [buttons, select]))
  if: rich_status != 200
    call: assert(rich_status == 201, "live v0.3: send rich Discord message")
  print: "LIVE PASS: Discord REST accepted rich message with embed, button and string select"

  set received_rich: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "message"
      if: event.content == rich_marker
        set received_embeds: map_get(event.payload, "embeds", [])
        set received_components: map_get(event.payload, "components", [])
        call: assert(len(received_embeds) == 1, "live v0.3: embed delivered")
        call: assert(len(received_components) == 2, "live v0.3: components delivered")
        set received_rich: 1
        set attempts: 60
      else:
        set attempts: attempts + 1
    else if: event.kind == "error"
      throw: "live v0.3: Gateway disconnected before rich message"
    else:
      set attempts: attempts + 1
  call: assert(received_rich == 1, "live v0.3: missing rich Gateway event")
  print: "LIVE PASS: Discord Gateway confirmed rich embed, button and select in MESSAGE_CREATE"

  call: assert(app.stop() == 1, "live v0.2: disconnect")
  print: "LIVE PASS: clean flOW shutdown"
  print: "LIVE V0.2 COMPLETE: real Discord Gateway, OW event parsing, command registration and message delivery"
