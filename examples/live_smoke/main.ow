# Live Discord integration test for the v0.2 OW-native command router and event parser.
# Uses a real bot token from the GitHub Actions secret, never from source code.
# Creates/updates two slash commands and sends one marked message to a test channel.
# Requires DISCORD_BOT_TOKEN, DISCORD_APPLICATION_ID, DISCORD_GUILD_ID,
# DISCORD_TEST_CHANNEL_ID, named intents and metadata cache configuration.
import "@flow/src/App.ow"
import "../../src/gateway/api/GatewayApi.ow"
import "../../src/gateway/infra/JvmGateway.ow"
import "../../src/rest/api/RestApi.ow"
import "../../src/rest/infra/JvmRest.ow"
import "../../src/client/OWCordClient.ow"
import "../../src/commands/CommandOptions.ow"
import "../../src/components/DiscordUI.ow"

main:
  set app: new App()
  call: app.use_native_as(OWCord.JvmGateway, "DISCORD_GATEWAY")
  call: app.use_native_as(OWCord.JvmRest, "DISCORD_REST")
  call: assert(app.boot() == 1, "live v0.2: flOW boot")

  set gateway DISCORD_GATEWAY: app.service("gateway")
  set rest DISCORD_REST: app.service("rest")
  set bot: new OWCordClient(gateway, rest)

  call: assert(bot.command("ping", "Replies with Pong from OW", "ping_handler") == 1, "live v0.2: add ping")
  call: assert(bot.command("hello", "Say hello in private", "hello_handler") == 1, "live v0.2: add hello")
  call: assert(bot.command("ping", "Duplicate", "other_handler") == 0, "live v0.2: reject duplicate")
  call: assert(bot.command_count() == 2, "live v0.2: registry count")
  print: "LIVE PASS: flOW lifecycle and OW command router"

  set ready: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "ready"
      set ready: 1
      set attempts: 60
    else if: event.kind == "error"
      throw: "live v0.2: Discord Gateway error before READY"
    else:
      set attempts: attempts + 1
  call: assert(ready == 1, "live v0.2: READY timeout")
  call: assert(gateway.connected() == 1, "live v0.2: active connection")
  print: "LIVE PASS: Discord Gateway READY parsed by OW EventParser"

  # v0.6: register one real typed slash command with autocomplete metadata.
  set builder: new CommandOptions()
  set search_schema: [builder.string_option("query", "Search a sample name", true, true)]
  call: assert(bot.command_options("owdemo6", "v0.6 live option registration", "demo_handler", search_schema) == 1, "live v0.6: register option schema")
  call: assert(bot.sync_dev_commands() == 1, "live v0.2: register /ping and /hello")
  print: "LIVE PASS: OW CommandRouter registered /ping, /hello and typed /owdemo6 via Discord REST"

  set channel: extension("owcord.test.channel_id")
  set marker: "OWCord v0.2 live smoke " + str(time_ms())
  set sent: bot.send_message(channel, marker)
  if: sent != 200
    call: assert(sent == 201, "live v0.2: send test message")
  print: "LIVE PASS: Discord REST accepted a real message"

  set received: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "message"
      if: event.content == marker
        call: assert(event.channel_id == channel, "live v0.2: channel id")
        call: assert(event.id != "", "live v0.2: message snowflake id")
        call: assert(event.user_id != "", "live v0.2: author id")
        set received: 1
        set attempts: 60
      else:
        set attempts: attempts + 1
    else if: event.kind == "error"
      throw: "live v0.2: Gateway error while waiting for message"
    else:
      set attempts: attempts + 1
  call: assert(received == 1, "live v0.2: matching MESSAGE_CREATE not received")
  print: "LIVE PASS: real MESSAGE_CREATE normalized with channel, author and message IDs"

  # v0.3 real Discord message with OW embed + interactive components.
  set ui: new DiscordUI()
  set rich_marker: "OWCord v0.3 rich smoke " + str(time_ms())
  set embed: ui.embed("OWCord rich smoke", "Embeds and components from native OW source", 5793266)
  set buttons: ui.row([ui.button("owcord_smoke_button", "Click to test", 1)])
  set select: ui.row([ui.select("owcord_smoke_select", "Select a color", [ui.option("Blue", "blue", "Option A"), ui.option("Green", "green", "Option B")])])
  set rich_status: bot.send_rich(channel, ui.message(rich_marker, [embed], [buttons, select]))
  if: rich_status != 200
    call: assert(rich_status == 201, "live v0.3: send rich Discord message")
  print: "LIVE PASS: Discord REST accepted rich message with embed, button and string select"

  set received_rich: 0
  set attempts: 0
  while: attempts < 60
    set event: bot.next(1000)
    if: event.kind == "message"
      if: event.content == rich_marker
        set received_embeds: map_get(event.payload, "embeds", [])
        set received_components: map_get(event.payload, "components", [])
        call: assert(len(received_embeds) == 1, "live v0.3: embed delivered")
        call: assert(len(received_components) == 2, "live v0.3: components delivered")
        set received_rich: 1
        set attempts: 60
      else:
        set attempts: attempts + 1
    else if: event.kind == "error"
      throw: "live v0.3: Gateway disconnected before rich message"
    else:
      set attempts: attempts + 1
  call: assert(received_rich == 1, "live v0.3: missing rich Gateway event")
  print: "LIVE PASS: Discord Gateway confirmed rich embed, button and select in MESSAGE_CREATE"

  # v0.7 message/reaction lifecycle. Only mutate the message ID returned by
  # the bot's own create request in this dedicated development channel.
  set lifecycle_marker: "OWCord v0.7 lifecycle smoke " + str(time_ms())
  set created_id: bot.message_create(channel, lifecycle_marker)
  call: assert(created_id != "", "live v0.7: new message ID")
  set retrieved: bot.message_get(channel, created_id)
  call: assert(retrieved.id == created_id, "live v0.7: fetched message ID")
  call: assert(retrieved.channel_id == channel, "live v0.7: fetched channel ID")
  call: assert(retrieved.content == lifecycle_marker, "live v0.7: fetched content")

  set listing: bot.message_list(channel, "", "before", 50)
  set found_message: 0
  set page_index: 0
  while: page_index < len(listing)
    if: listing[page_index].id == created_id
      set found_message: 1
    set page_index: page_index + 1
  call: assert(found_message == 1, "live v0.7: message appears in paginated list")
  print: "LIVE PASS: create/get/paginate real Discord message and exact snowflake ID"

  set edited: bot.message_edit(channel, created_id, lifecycle_marker + " EDITED")
  call: assert(edited.id == created_id, "live v0.7: edit ID")
  call: assert(edited.content == lifecycle_marker + " EDITED", "live v0.7: edit response")
  print: "LIVE PASS: edit real bot-owned Discord message"

  set added: bot.reaction_add(channel, created_id, "👍")
  call: assert(added == 204, "live v0.7: add own reaction")
  set reactors: bot.reaction_users(channel, created_id, "👍", "", 10)
  call: assert(len(reactors) > 0, "live v0.7: read reaction users")
  set removed: bot.reaction_remove(channel, created_id, "👍")
  call: assert(removed == 204, "live v0.7: remove own reaction")
  print: "LIVE PASS: own reaction add/read/remove in real Discord"

  set deleted: bot.message_delete(channel, created_id)
  call: assert(deleted == 204, "live v0.7: delete bot-owned message")
  print: "LIVE PASS: deleted only the test message created in this run"

  # v0.8 live inspection: read-only, no channel/role/member changes.
  set guild_id: extension("owcord.test.guild_id")
  set guild: bot.guild_get(guild_id)
  call: assert(guild.id == guild_id, "live v0.8: guild ID")
  call: assert(guild.name != "", "live v0.8: guild name")
  set live_channel: bot.channel_get(channel)
  call: assert(live_channel.id == channel, "live v0.8: channel ID")
  set channels: bot.guild_channels(guild_id)
  call: assert(len(channels) > 0, "live v0.8: visible guild channels")
  set roles: bot.guild_roles(guild_id)
  call: assert(len(roles) > 0, "live v0.8: at least one guild role")
  print: "LIVE PASS: v0.8 guild, channel and role read-only REST inspection"

  # v0.9: read-only live authorization evaluation for the bot itself.
  # No kick, timeout, ban, unban or role changes are invoked in this smoke.
  set bot_id: extension("owcord.test.application_id")
  set current_member: bot.guild_member(guild_id, bot_id)
  call: assert(current_member.user_id == bot_id, "live v0.9: own bot member")
  set effective: bot.effective_permissions(guild_id, bot_id, channel)
  call: assert(effective != "", "live v0.9: effective permissions decimal string")
  call: assert(bot.has_permission(effective, "1024") == 1, "live v0.9: test channel visible")
  call: assert(bot.can_moderate(guild_id, bot_id, bot_id, "kick") == 0, "live v0.9: cannot kick self")
  print: "LIVE PASS: v0.9 read-only permission calculation and self-moderation denial"

  # v0.10 Components V2: bot-owned temp message only, no global commands.
  set v2_card: ui.v2_container([
    ui.v2_text("## OWCord v0.10"),
    ui.v2_separator(true, 1),
    ui.v2_section([ui.v2_text("Components V2 is active!")],
      ui.button("owcord10_verify", "Verify", 1))
  ], 5793266)
  set v2_data: ui.v2_message([v2_card])
  set v2_id: bot.v2_create(channel, v2_data)
  call: assert(v2_id != "", "live v0.10: V2 message created")
  set v2_fetched: bot.message_get(channel, v2_id)
  call: assert(v2_fetched.id == v2_id, "live v0.10: V2 message found")
  call: assert(bot.message_delete(channel, v2_id) == 204, "live v0.10: V2 cleanup")
  print: "LIVE PASS: v0.10 native OW Components V2 created, verified and deleted"

  # v0.11: prove named intents and opt-in cache are configured on live bot.
  # No privileged intents, member enumeration or server configuration changes.
  set profile: bot.gateway_intents()
  call: assert(profile.mask == 513, "live v0.11: named intents evaluated to 513")
  call: assert(profile.portal_configuration_required == false, "live v0.11: no privileged intents")
  set cache_info: bot.gateway_cache_stats()
  call: assert(cache_info.mode == "metadata", "live v0.11: metadata cache enabled")
  call: assert(cache_info.max_entries == 64, "live v0.11: bounded cache")
  call: assert(cache_info.ttl_seconds == 120, "live v0.11: cache TTL")
  set maybe_guild: bot.cached_guild(guild_id)
  call: assert(map_has(maybe_guild, "found"), "live v0.11: cache exposes explicit hit/miss")
  call: assert(bot.clear_gateway_cache() == 1, "live v0.11: explicit invalidation")
  print: "LIVE PASS: v0.11 named intents, bounded cache and safe read-only introspection"

  call: assert(app.stop() == 1, "live v0.2: disconnect")
  print: "LIVE PASS: clean flOW shutdown"
  print: "LIVE V0.2 COMPLETE: real Discord Gateway, OW event parsing, command registration and message delivery"
