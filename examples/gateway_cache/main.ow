# Read-only OWCord v0.11 Gateway intents / cache inspection.
# Requires configured bot in environment; no privileged intents required.
import "@flow/src/App.ow"
import "../../src/gateway/api/GatewayApi.ow"
import "../../src/gateway/infra/JvmGateway.ow"
import "../../src/rest/api/RestApi.ow"
import "../../src/rest/infra/JvmRest.ow"
import "../../src/client/OWCordClient.ow"

main:
  set app: new App()
  call: app.use_native_as(OWCord.JvmGateway, "DISCORD_GATEWAY")
  call: app.use_native_as(OWCord.JvmRest, "DISCORD_REST")
  call: assert(app.boot() == 1, "cache demo: flOW boot")
  set gateway DISCORD_GATEWAY: app.service("gateway")
  set rest DISCORD_REST: app.service("rest")
  set bot: new OWCordClient(gateway, rest)
  set settings: bot.gateway_intents()
  print: "Gateway intent mask: " + str(settings.mask)
  set stats: bot.gateway_cache_stats()
  print: "Cache mode: " + stats.mode
  print: "Cache entry limit: " + str(stats.max_entries)
  set guild: extension("owcord.test.guild_id")
  set cached: bot.cached_guild(guild)
  if: cached.found == true
    print: "Partial guild cache hit"
  else:
    print: "No guild metadata cached yet"
  call: assert(app.stop() == 1, "cache demo: clean shutdown")
